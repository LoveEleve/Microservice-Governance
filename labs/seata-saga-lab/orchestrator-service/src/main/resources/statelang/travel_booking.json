{
  "Name": "travelBooking",
  "Comment": "Travel booking Saga across flight, hotel and car services",
  "Version": "0.0.1",
  "StartState": "BookFlight",
  "States": {
    "BookFlight": {
      "Type": "ServiceTask",
      "ServiceName": "travelBookingGateway",
      "ServiceMethod": "bookFlight",
      "CompensateState": "CancelFlight",
      "Catch": [
        {
          "Exceptions": ["java.lang.Exception"],
          "Next": "CompensationTrigger"
        }
      ],
      "Next": "BookHotel"
    },
    "BookHotel": {
      "Type": "ServiceTask",
      "ServiceName": "travelBookingGateway",
      "ServiceMethod": "bookHotel",
      "CompensateState": "CancelHotel",
      "Catch": [
        {
          "Exceptions": ["java.lang.Exception"],
          "Next": "CompensationTrigger"
        }
      ],
      "Next": "BookCar"
    },
    "BookCar": {
      "Type": "ServiceTask",
      "ServiceName": "travelBookingGateway",
      "ServiceMethod": "bookCar",
      "CompensateState": "CancelCar",
      "Catch": [
        {
          "Exceptions": ["java.lang.Exception"],
          "Next": "CompensationTrigger"
        }
      ],
      "Next": "Success"
    },
    "CancelCar": {
      "Type": "ServiceTask",
      "ServiceName": "travelBookingGateway",
      "ServiceMethod": "cancelCar",
      "IsForCompensation": true
    },
    "CancelHotel": {
      "Type": "ServiceTask",
      "ServiceName": "travelBookingGateway",
      "ServiceMethod": "cancelHotel",
      "IsForCompensation": true
    },
    "CancelFlight": {
      "Type": "ServiceTask",
      "ServiceName": "travelBookingGateway",
      "ServiceMethod": "cancelFlight",
      "IsForCompensation": true
    },
    "CompensationTrigger": {
      "Type": "CompensationTrigger",
      "Next": "CompensateEnd"
    },
    "CompensateEnd": {
      "Type": "Fail",
      "ErrorCode": "StateCompensated",
      "Message": "Travel booking compensated"
    },
    "Success": {
      "Type": "Succeed"
    }
  }
}
